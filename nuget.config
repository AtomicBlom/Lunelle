<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Everything Lunelle takes comes from nuget.org, BinaryVibrance.Sirrow included (when SirrowSource is none) -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
