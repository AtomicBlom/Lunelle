<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lunelle's tests: the chip, patches, kits, music and its player (BinaryVibrance.Lunelle), the measures, and the music
       generator. What these test needs no window, GPU or output device: they render offline. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TUnit runs on Microsoft.Testing.Platform, whose source generator emits the executable entry point. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Shouldly" />
    <!-- Compiles the C# that PatchCode writes, to check it builds the patch it was written from -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
    <Using Include="BinaryVibrance.Sirrow" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BinaryVibrance.Lunelle\BinaryVibrance.Lunelle.csproj" />
    <!-- Driven in-process by MusicGeneratorTests, as a library rather than as this project's analyzer -->
    <ProjectReference Include="..\BinaryVibrance.Lunelle.Music.Generator\BinaryVibrance.Lunelle.Music.Generator.csproj" />
    <!-- The sample music project, whose generated music is checked against its files -->
    <ProjectReference Include="..\samples\HelloSynth\HelloSynth.csproj" />
  </ItemGroup>

</Project>
