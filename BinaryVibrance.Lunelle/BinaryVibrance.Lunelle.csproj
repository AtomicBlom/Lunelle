<Project Sdk="Microsoft.NET.Sdk">
	<!-- Synthesis and music over Sirrow: a fixed-voice synthesizer chip with patches as data, samples and drum kits,
	     music written as code or files (scales, notation, songs, a sequencer), and measures for designing patches. Built on
	     Sirrow's mixer, effects and DSP building blocks; depends only on Sirrow and the BCL. -->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>
	<PropertyGroup Label="NuGet">
		<PackageId>BinaryVibrance.Lunelle</PackageId>
		<Description>A synthesizer for .NET games, on Sirrow: a 16-operator chip with patches as data, sampled drum kits, and music written as code or files, played by a sequencer on the audio clock.</Description>
		<PackageTags>audio;synthesis;fm;music;sequencer;gamedev;dotnet</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="BinaryVibrance.Lunelle.Tests" />
		<InternalsVisibleTo Include="BinaryVibrance.LunelleStudio.Tests" />
	</ItemGroup>
	<!-- Sirrow from its checkout (SirrowSource, build/Sirrow.Source.props), or its package where SirrowSource is none -->
	<PropertyGroup>
		<_LunelleNeedsSirrowSource>true</_LunelleNeedsSirrowSource>
	</PropertyGroup>
	<ItemGroup Condition="'$(SirrowSource)' != 'none'">
		<ProjectReference Include="$(SirrowSource)BinaryVibrance.Sirrow\BinaryVibrance.Sirrow.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(SirrowSource)' == 'none'">
		<PackageReference Include="BinaryVibrance.Sirrow" />
	</ItemGroup>
	<!-- What the chip is made of, and runs on, without a using in every file -->
	<ItemGroup>
		<Using Include="BinaryVibrance.Sirrow" />
	</ItemGroup>
	<!-- The music generator, packed as this package's analyzer, so a project writing music for the chip (its patch and song
	     files) gets it with the package; build/BinaryVibrance.Lunelle.props makes visible the properties it reads. Built first,
	     never referenced: it is a netstandard2.0 analyzer, no part of this assembly. -->
	<ItemGroup>
		<ProjectReference Include="..\BinaryVibrance.Lunelle.Music.Generator\BinaryVibrance.Lunelle.Music.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<None Include="..\BinaryVibrance.Lunelle.Music.Generator\bin\$(Configuration)\netstandard2.0\BinaryVibrance.Lunelle.Music.Generator.dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
		<None Include="build\BinaryVibrance.Lunelle.props" Pack="true" PackagePath="build" />
	</ItemGroup>
</Project>
